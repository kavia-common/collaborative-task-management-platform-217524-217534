# Example environment variables for TaskBoards backend

# Database connection string (Postgres)
# Format examples:
#   postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
#   postgresql+psycopg://postgres:postgres@localhost:5432/taskboards
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/taskboards

# JWT / Auth
SECRET_KEY=change_me_to_a_secure_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS
# Comma-separated list, e.g., http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_ORIGINS=http://localhost:3000

# WebSocket allowed origins (comma-separated)
WEBSOCKET_ORIGINS=http://localhost:3000
