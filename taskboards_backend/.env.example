# TaskBoards Backend - Environment Variables (Example)
# Copy this file to .env and fill in the placeholders.

# REQUIRED: Database connection URL
# Examples:
# postgresql+psycopg://user:password@localhost:5432/taskboards
# For Docker example in SETUP_DB.md: postgresql+psycopg://taskboards_user:taskboards_pass@localhost:5432/taskboards
DATABASE_URL=

# REQUIRED: Secret key for JWT signing (set a long, random string)
SECRET_KEY=change-me-please

# OPTIONAL: JWT expiration in minutes (default 60)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# OPTIONAL: CORS allowed origins (comma-separated). Example: http://localhost:3000
CORS_ALLOW_ORIGINS=http://localhost:3000

# OPTIONAL: Websocket allowed origins (comma-separated). Used by proxies/gateways as needed.
WEBSOCKET_ORIGINS=http://localhost:3000
